{
  "id": "clock",
  "version": "0.6.0",
  "name": {
    "en": "Clock",
    "fr": "Horloge"
  },
  "description": {
    "en": "Digital or analog clock with today's date (in analog mode, the face sits on the left and the text on the right when the date is shown, so the face keeps the tile's full height), an optional French nameday, and an optional day/night background that follows the board's sun-based theme. A chosen time zone (with up to 3 secondary zones shown small), a week number (two conventions to choose from), up to 5 independent alarms, and a \"next event\" line fed by an independent calendar.",
    "fr": "Horloge digitale ou analogique avec la date du jour (en mode analogique, le cadran se cale à gauche et le texte à droite quand la date est affichée, pour que le cadran garde toute la hauteur de la tuile), le saint du jour en option, et un fond jour/nuit optionnel qui suit le thème solaire du tableau. Fuseau horaire choisi (avec jusqu'à 3 fuseaux secondaires affichés en petit), numéro de semaine (deux conventions au choix), jusqu'à 5 alarmes indépendantes, et une ligne « prochain événement » alimentée par un calendrier indépendant."
  },
  "tagline": {
    "en": "Digital or analog clock, with today's date.",
    "fr": "Horloge digitale ou analogique, avec la date du jour."
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 1,
    "minH": 1,
    "maxW": 6,
    "maxH": 5
  },
  "settings": [
    {
      "key": "mode",
      "type": "select",
      "default": "digital",
      "label": {
        "en": "Display",
        "fr": "Affichage"
      },
      "options": [
        {
          "value": "digital",
          "label": {
            "en": "Digital",
            "fr": "Digitale"
          }
        },
        {
          "value": "analog",
          "label": {
            "en": "Analog",
            "fr": "Analogique"
          }
        }
      ]
    },
    {
      "key": "showSeconds",
      "type": "checkbox",
      "default": false,
      "label": {
        "en": "Show seconds",
        "fr": "Afficher les secondes"
      }
    },
    {
      "key": "showDate",
      "type": "checkbox",
      "default": true,
      "label": {
        "en": "Show date",
        "fr": "Afficher la date"
      }
    },
    {
      "key": "dateFormat",
      "type": "select",
      "default": "full",
      "label": {
        "en": "Date format",
        "fr": "Format de la date"
      },
      "hint": {
        "en": "Shorter formats free up room on small tiles.",
        "fr": "Les formats plus courts libèrent de la place sur les petites tuiles."
      },
      "options": [
        {
          "value": "full",
          "label": {
            "en": "Full — Friday, July 25, 2026",
            "fr": "Complet — vendredi 25 juillet 2026"
          }
        },
        {
          "value": "long",
          "label": {
            "en": "Long — July 25, 2026",
            "fr": "Long — 25 juillet 2026"
          }
        },
        {
          "value": "medium",
          "label": {
            "en": "Medium — Fri, Jul 25",
            "fr": "Moyen — ven. 25 juil."
          }
        },
        {
          "value": "short",
          "label": {
            "en": "Short — 07/25/2026",
            "fr": "Court — 25/07/2026"
          }
        }
      ]
    },
    {
      "key": "showSaint",
      "type": "checkbox",
      "default": false,
      "label": {
        "en": "Show name day (French tradition)",
        "fr": "Afficher le saint du jour"
      },
      "hint": {
        "en": "Adds the French \"fête du jour\" next to the date (e.g. \"Sainte Christine\"). Only shown when the date is displayed and the interface language is French — this calendar is a French cultural tradition without an English equivalent.",
        "fr": "Ajoute la fête du jour à côté de la date (ex. « Sainte Christine »). Visible seulement quand la date est affichée et que la langue de l'interface est le français — ce calendrier est une tradition culturelle française sans équivalent anglophone."
      }
    },
    {
      "key": "saintLayout",
      "type": "select",
      "default": "below",
      "label": {
        "en": "Name day arrangement",
        "fr": "Disposition du saint du jour"
      },
      "hint": {
        "en": "\"Below\" automatically switches to \"Side by side\" on tiles too short for a 2nd line, or when the time/date arrangement below is already \"Side by side\" — the name day is never allowed to overflow the tile.",
        "fr": "« En dessous » bascule automatiquement sur « Côté à côté » sur les tuiles trop basses pour une 2e ligne, ou quand la disposition heure/date ci-dessous est déjà « Côté à côté » — le saint du jour ne déborde jamais de la tuile."
      },
      "options": [
        {
          "value": "below",
          "label": {
            "en": "Below the date",
            "fr": "En dessous de la date"
          }
        },
        {
          "value": "inline",
          "label": {
            "en": "Side by side with the date",
            "fr": "Côte à côte avec la date"
          }
        }
      ]
    },
    {
      "key": "layout",
      "type": "select",
      "default": "stacked",
      "label": {
        "en": "Time and date arrangement",
        "fr": "Disposition heure et date"
      },
      "hint": {
        "en": "Only applies to the digital clock when the date is shown. Side by side works best on wide, short tiles.",
        "fr": "S'applique seulement à l'horloge digitale quand la date est affichée. Côte à côte convient surtout aux tuiles larges et basses."
      },
      "options": [
        {
          "value": "stacked",
          "label": {
            "en": "Date below the time",
            "fr": "Date sous l'heure"
          }
        },
        {
          "value": "row",
          "label": {
            "en": "Side by side",
            "fr": "Côte à côte"
          }
        }
      ]
    },
    {
      "key": "dayNightBg",
      "type": "checkbox",
      "default": true,
      "label": {
        "en": "Day/night background",
        "fr": "Fond jour/nuit"
      },
      "hint": {
        "en": "Switches automatically with the board's theme (sunrise/sunset, or your manual day/night choice). Overrides the tile's custom color from the Appearance section below while enabled.",
        "fr": "Bascule automatiquement avec le thème du tableau (lever/coucher du soleil, ou votre choix manuel jour/nuit). Prend le pas sur la couleur personnalisée de la tuile (section Apparence ci-dessous) tant que c'est activé."
      }
    },
    {
      "key": "dayColor",
      "type": "color",
      "default": "#DCE9F7",
      "label": {
        "en": "Day color",
        "fr": "Couleur de jour"
