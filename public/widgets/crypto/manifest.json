{
  "id": "crypto",
  "version": "0.3.0",
  "name": {
    "en": "Crypto prices",
    "fr": "Cours Cryptos"
  },
  "titleBar": false,
  "description": {
    "en": "Live prices and 24h change for a few coins, powered by CoinGecko (no API key). Tap a coin to see its price chart (24h / 7d / 30d / 1y).",
    "fr": "Cours en direct et variation 24h de quelques cryptomonnaies, via CoinGecko (sans clé API). Touchez une crypto pour voir sa courbe (24h / 7j / 30j / 1an)."
  },
  "tagline": {
    "en": "Live prices of your favorite cryptocurrencies.",
    "fr": "Cours en direct de vos cryptomonnaies favorites."
  },
  "size": {
    "w": 3,
    "h": 2,
    "minW": 1,
    "minH": 1,
    "maxW": 6,
    "maxH": 6
  },
  "settings": [
    {
      "key": "coins",
      "type": "text",
      "default": "bitcoin,ethereum",
      "label": {
        "en": "Coins (CoinGecko ids, comma-separated)",
        "fr": "Cryptos (identifiants CoinGecko, séparés par des virgules)"
      }
    },
    {
      "key": "currency",
      "type": "select",
      "default": "eur",
      "label": {
        "en": "Currency",
        "fr": "Devise"
      },
      "options": [
        {
          "value": "eur",
          "label": {
            "en": "Euro (€)",
            "fr": "Euro (€)"
          }
        },
        {
          "value": "usd",
          "label": {
            "en": "US Dollar ($)",
            "fr": "Dollar US ($)"
          }
        }
      ]
    },
    {
      "key": "refresh",
      "type": "number",
      "default": 5,
      "min": 1,
      "max": 60,
      "step": 1,
      "label": {
        "en": "Refresh (minutes)",
        "fr": "Rafraîchissement (minutes)"
      }
    },
    {
      "key": "chartBgColor",
      "type": "color",
      "default": "#141926",
      "label": {
        "en": "Chart background",
        "fr": "Fond du graphique"
      },
      "group": {
        "en": "Chart",
        "fr": "Graphique"
      }
    },
    {
      "key": "chartLineColor",
      "type": "color",
      "default": "#D6335C",
      "label": {
        "en": "Curve color",
        "fr": "Couleur de la courbe"
      },
      "group": {
        "en": "Chart",
        "fr": "Graphique"
      }
    },
    {
      "key": "chartGridColor",
      "type": "color",
      "default": "#565E73",
      "label": {
        "en": "Gridlines and value labels",
        "fr": "Traits de repère et valeurs"
      },
      "hint": {
        "en": "Horizontal lines shown behind the curve, with a price value next to each, to help judge fluctuations at a glance.",
        "fr": "Traits horizontaux affichés derrière la courbe, avec une valeur de prix en regard de chacun, pour évaluer les fluctuations d'un coup d'œil."
      },
      "group": {
        "en": "Chart",
        "fr": "Graphique"
      }
    }
  ]
}
